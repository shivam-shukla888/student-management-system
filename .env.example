# ==========================================
# Student Management System - Environment Config
# ==========================================

# Backend Server Port
PORT=5000

# Application Environment (development | production | test)
NODE_ENV=development

# Allowed Frontend CORS Origin
CORS_ORIGIN=http://localhost:5173

# SQLite Database File Storage Path (optional, defaults to backend/data/students.db)
DB_PATH=./data/students.db

# Enable verbose SQL logging in development (optional: true | false)
DEBUG_SQL=false

# Frontend API Base URL (optional for production deployment)
VITE_API_BASE_URL=/api
